{
  "name": "operation-nexus",
  "productName": "COE Nexus",
  "version": "1.0.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "dev:debug": "unset ELECTRON_RUN_AS_NODE && electron-vite dev -- --remote-debugging-port=9222 --inspect=9229",
    "build": "electron-vite build",
    "preview": "unset ELECTRON_RUN_AS_NODE && electron-vite preview",
    "start": "unset ELECTRON_RUN_AS_NODE && electron-vite preview",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.ts",
    "test:e2e:cdp": "npx playwright test --config=e2e/cdp/playwright.config.ts",
    "rebuild": "npx tsx scripts/download-sqlite-vec.ts --force && npx electron-rebuild -f -w better-sqlite3",
    "postinstall": "npx tsx scripts/download-sqlite-vec.ts && npx electron-rebuild -w better-sqlite3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.140",
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@splinetool/react-spline": "^4.0.0",
    "@splinetool/runtime": "^1.9.0",
    "@tanstack/react-query": "^5.75.0",
    "appdmg": "^0.6.6",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.0",
    "docx-preview": "^0.3.3",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "electron-updater": "^6.6.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.0.0",
    "mammoth": "^1.8.0",
    "motion": "^12.0.0",
    "nodemailer": "^6.10.0",
    "pdfjs-dist": "^5.0.0",
    "playwright": "^1.52.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.6.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-dmg": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.0",
    "@electron-forge/plugin-fuses": "^7.8.0",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^41.2.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.2",
    "vitest": "^4.0.0"
  }
}
