# ============================================================
# Operation Nexus — Electron + .NET hybrid
# ============================================================

# ── Node / Electron ─────────────────────────────────────────
node_modules/
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo
*.local

# Electron Forge / electron-vite output
out/make/
out/publish/

# Native extensions (downloaded per-platform)
resources/sqlite-vec/*.dylib
resources/sqlite-vec/*.so
resources/sqlite-vec/*.dll

# ── .NET / C# ───────────────────────────────────────────────
**/bin/
**/obj/
*.dll
*.exe
*.pdb
*.nupkg
*.snupkg
*.user
*.suo
*.userosscache
*.sln.docstates
*.mdf
*.ldf
*.ndf

# NuGet
**/packages/
*.nuget.props
*.nuget.targets

# .NET tool manifests
.config/dotnet-tools.json

# Project-level caches
project.lock.json
project.fragment.lock.json
artifacts/

# Rider / ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/

# ── Environment & Secrets ───────────────────────────────────
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing / Coverage ──────────────────────────────────────
coverage/
TestResults/
*.trx

# ── OS artifacts ─────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Editors ──────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sw?
*~

# ── Installers / Packaged output ────────────────────────────
*.dmg
*.exe
*.AppImage
*.deb
*.rpm
*.snap
*.msi

# ── Misc ─────────────────────────────────────────────────────
*.har
.agentstudio/
.agent-studio/

# Obsidian — track shared config, ignore personal workspace state
docs/.obsidian/workspace.json
docs/.obsidian/workspace-mobile.json
docs/.obsidian/graph.json

# SQLite databases (user data, not source)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
